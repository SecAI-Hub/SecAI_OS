#!/usr/sbin/nft -f
# Native offline default. Only appliance-owned tables are replaced.
# Online sets are EMPTY at boot. Grants require verified wildcard netdev
# hooks (nftables >=1.1.6 and kernel support) and expire in the kernel.
# These placeholder identities grant nothing with empty sets; the root
# network controller substitutes the installed dedicated service identities.
define TOR_GID = 65534
define AIRLOCK_UID = 65534

add table inet secure_ai
delete table inet secure_ai
table inet secure_ai {
    set online { type nf_proto; flags timeout; }
    set full { type nf_proto; flags timeout; }
    set maintenance { type nf_proto; flags timeout; }
    chain input {
        type filter hook input priority -300; policy drop;
        iifname "lo" accept
        ct state established,related accept
        udp sport 67 udp dport 68 meta nfproto @online accept
        udp sport 547 udp dport 546 meta nfproto @online accept
        icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert } meta nfproto @online accept
    }
    chain forward {
        type filter hook forward priority -300; policy drop;
    }
    chain output {
        type filter hook output priority -500; policy drop;
        oifname "lo" accept
        meta nfproto @online jump allowed
    }
    chain allowed {
        udp sport 68 udp dport 67 accept
        udp sport 546 udp dport 547 accept
        icmpv6 type { nd-router-solicit, nd-neighbor-solicit, nd-neighbor-advert } accept
        meta skgid $TOR_GID meta l4proto tcp accept
        meta skuid $AIRLOCK_UID tcp dport { 53, 443 } meta nfproto @full accept
        meta skuid $AIRLOCK_UID udp dport 53 meta nfproto @full accept
        tcp dport { 53, 443 } meta nfproto @maintenance accept
        udp dport { 53, 123 } meta nfproto @maintenance accept
    }
}
add table netdev secure_ai_link
delete table netdev secure_ai_link
table netdev secure_ai_link {
    set online { type ether_type; flags timeout; }
    set full { type ether_type; flags timeout; }
    set maintenance { type ether_type; flags timeout; }
    chain output {
        type filter hook egress devices = { "*" } priority -500; policy drop;
        oifname "lo" accept
        meta protocol @online jump allowed
    }
    chain allowed {
        ether type arp accept
        udp sport 68 udp dport 67 accept
        udp sport 546 udp dport 547 accept
        icmpv6 type { nd-router-solicit, nd-neighbor-solicit, nd-neighbor-advert } accept
        meta skgid $TOR_GID meta l4proto tcp accept
        meta skuid $AIRLOCK_UID tcp dport { 53, 443 } meta protocol @full accept
        meta skuid $AIRLOCK_UID udp dport 53 meta protocol @full accept
        tcp dport { 53, 443 } meta protocol @maintenance accept
        udp dport { 53, 123 } meta protocol @maintenance accept
    }
}
