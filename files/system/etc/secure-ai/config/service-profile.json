{
  "version": 1,
  "profile": "native-appliance",
  "credential_model": "least-privilege-action-scoped-v1",
  "credential_model_note": "Registry and incident-recorder APIs use endpoint- and source-scoped bearer credentials. Containment, UI control, recovery administration, forensic export, and agent signing remain independent capabilities.",
  "services": [
    {"id": "credentials", "unit": "secure-ai-credentials.service", "required": true, "health_url": "", "inbound_credential": ""},
