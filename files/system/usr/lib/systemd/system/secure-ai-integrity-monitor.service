[Unit]
Description=Secure AI Continuous Integrity Monitor (baseline-verified file watcher)
ConditionPathExists=/var/lib/secure-ai/vault/.initialized
RequiresMountsFor=/var/lib/secure-ai/vault/models
# Starts after attestor and policy engine; monitors all service binaries and policies
Requires=secure-ai-credentials.service secure-ai-firstboot.service secure-ai-vault-mounted.service
After=secure-ai-runtime-attestor.service secure-ai-policy-engine.service network.target secure-ai-credentials.service secure-ai-firstboot.service secure-ai-vault-mounted.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/libexec/secure-ai/landlock-apply.py --require integrity_monitor -- /usr/libexec/secure-ai/integrity-monitor
Environment=BIND_ADDR=127.0.0.1:8510
Environment=MONITOR_POLICY_PATH=/etc/secure-ai/policy/integrity-monitor.yaml
Environment=AUDIT_LOG_PATH=/var/lib/secure-ai/logs/integrity-monitor-audit.jsonl
Environment=SERVICE_TOKEN_PATH=%d/service-token
Environment=HMAC_KEY_PATH=%d/integrity-hmac-key
Environment=INCIDENT_RECORDER_TOKEN_PATH=%d/incident-reporter-token
Environment=BASELINE_PATH=/var/lib/secure-ai/integrity/baseline.json
LoadCredential=service-token:/var/lib/secure-ai/credentials/integrity-monitor.token
LoadCredential=incident-reporter-token:/var/lib/secure-ai/credentials/incident-reporter-integrity-monitor.token
LoadCredential=integrity-hmac-key:/var/lib/secure-ai/credentials/integrity-hmac.key

# Filesystem isolation
DynamicUser=yes
SupplementaryGroups=secure-ai-logs secure-ai-integrity
ReadOnlyPaths=/etc/secure-ai
ReadOnlyPaths=/run/secure-ai
ReadOnlyPaths=/usr/libexec/secure-ai
ReadOnlyPaths=/usr/lib/systemd/system
ReadOnlyPaths=/var/lib/secure-ai/registry
ReadOnlyPaths=/var/lib/secure-ai/vault/models
ReadWritePaths=/var/lib/secure-ai/logs
ReadWritePaths=/var/lib/secure-ai/integrity
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid

# Kernel protection
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# Privilege restriction
NoNewPrivileges=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictRealtime=yes

# Capability bounding
CapabilityBoundingSet=
AmbientCapabilities=

# Namespace restrictions
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET

# PrivateNetwork=no — needs localhost HTTP for API and to read service binaries
PrivateNetwork=no

# Network restriction — monitor only exposes and reaches localhost APIs
IPAddressDeny=any
IPAddressAllow=localhost

# Syscall filtering
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @clock @debug @swap @reboot @raw-io @module @cpu-emulation @obsolete
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM

# Resource limits
MemoryMax=256M
CPUQuota=15%
TasksMax=32
LimitNOFILE=1024
LimitCORE=0

# Production timeouts and restart limits
TimeoutStartSec=30
TimeoutStopSec=15
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
