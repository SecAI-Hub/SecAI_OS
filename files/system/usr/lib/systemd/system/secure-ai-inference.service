[Unit]
Description=Secure AI Inference Worker (llama-server)
ConditionPathExists=/var/lib/secure-ai/vault/.initialized
RequiresMountsFor=/var/lib/secure-ai/vault/models
After=secure-ai-vault-mounted.service secure-ai-registry.service
Requires=secure-ai-vault-mounted.service secure-ai-registry.service

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/libexec/secure-ai/start-inference.sh
Environment=GPU_LAYERS=0
EnvironmentFile=-/var/lib/secure-ai/inference.env
Environment=CTX_SIZE=8192
Environment=THREADS=4
Environment=PORT=8465
WatchdogSec=30

# Filesystem isolation — needs GPU access, no network
DynamicUser=yes
SupplementaryGroups=video render secure-ai-registry
RuntimeDirectory=secure-ai-inference
RuntimeDirectoryMode=0700
ReadOnlyPaths=/etc/secure-ai
ReadOnlyPaths=/var/lib/secure-ai/vault/models
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid

# Kernel protection
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# Privilege restriction
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes

# Capability bounding
CapabilityBoundingSet=
AmbientCapabilities=

# Namespace restrictions
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET

# Inference is reachable only from local application peers.
IPAddressDeny=any
IPAddressAllow=localhost

# Syscall filtering — needs GPU ioctls, so allow @raw-io for CUDA/ROCm
SystemCallFilter=@system-service @io-event
SystemCallFilter=~@privileged @mount @clock @debug @swap @reboot @module @cpu-emulation @obsolete
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM

# GPU access — NVIDIA (CUDA), AMD (ROCm via /dev/kfd + /dev/dri), Intel (DRI)
DeviceAllow=/dev/nvidia* rw
DeviceAllow=/dev/dri/* rw
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia-uvm rw
DeviceAllow=/dev/nvidia-uvm-tools rw
DeviceAllow=/dev/kfd rw

# Resource limits — generous for inference; model worker isolation (M43)
MemoryMax=32G
CPUQuota=200%
TasksMax=256
LimitNPROC=64
LimitNOFILE=4096
LimitCORE=0

Restart=on-failure
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
