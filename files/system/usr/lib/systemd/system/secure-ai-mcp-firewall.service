[Unit]
Description=Secure AI MCP Firewall (Model Context Protocol policy gateway)
ConditionPathExists=/var/lib/secure-ai/vault/.initialized
After=secure-ai-vault-mounted.service secure-ai-tool-firewall.service secure-ai-credentials.service
Requires=secure-ai-vault-mounted.service secure-ai-credentials.service
Wants=secure-ai-tool-firewall.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/libexec/secure-ai/landlock-apply.py --require mcp_firewall -- /usr/libexec/secure-ai/mcp-firewall serve
Environment=BIND_ADDR=127.0.0.1:8496
Environment=MCP_FIREWALL_POLICY=/etc/secure-ai/mcp-firewall/default-policy.yaml
Environment=AUDIT_LOG=/var/lib/secure-ai/logs/mcp-firewall-audit.jsonl
Environment=SERVICE_TOKEN_PATH=%d/service-token
LoadCredential=service-token:/var/lib/secure-ai/credentials/mcp-firewall.token

# Filesystem isolation
DynamicUser=yes
SupplementaryGroups=secure-ai-logs secure-ai-vault-read
ReadOnlyPaths=/etc/secure-ai
ReadOnlyPaths=/run/secure-ai
ReadOnlyPaths=/var/lib/secure-ai/vault
ReadWritePaths=/var/lib/secure-ai/logs
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid

# Kernel protection
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# Privilege restriction
NoNewPrivileges=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictRealtime=yes

# Capability bounding
CapabilityBoundingSet=
AmbientCapabilities=

# Namespace restrictions
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET

# MCP firewall is reachable only by local control-plane peers.
IPAddressDeny=any
IPAddressAllow=localhost

# Syscall filtering
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @clock @debug @swap @reboot @raw-io @module @cpu-emulation @obsolete
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM

# Device cgroup — deny all device access (M43/M5)
DevicePolicy=closed
DeviceAllow=

# Resource limits (M43/M5 tightened)
MemoryMax=256M
CPUQuota=25%
TasksMax=32
LimitNPROC=32
LimitNOFILE=512
LimitCORE=0

# Production timeouts and restart limits
TimeoutStartSec=30
TimeoutStopSec=15
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
