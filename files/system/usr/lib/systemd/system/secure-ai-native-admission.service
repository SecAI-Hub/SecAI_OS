[Unit]
Description=Root admission for the Secure AI update-check writer
Before=secure-ai-update-check.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/secure-ai/secure-native-admission.py initialize
User=root
Group=root
UMask=0077
StateDirectory=secure-ai-native-admission
StateDirectoryMode=0700
RuntimeDirectory=secure-ai-native-admission
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectControlGroups=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @mount @clock @debug @swap @reboot @module @cpu-emulation @obsolete
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
LimitCORE=0
TimeoutStartSec=30
