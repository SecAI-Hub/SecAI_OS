[Unit]
Description=Secure AI Canary / Tripwire Check
Requires=secure-ai-credentials.service
Wants=secure-ai-incident-recorder.service
After=secure-ai-firstboot.service secure-ai-credentials.service secure-ai-incident-recorder.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/secure-ai/canary-check.sh check
Environment=CANARY_HMAC_KEY_PATH=%d/canary-hmac-key
Environment=INCIDENT_RECORDER_TOKEN_PATH=%d/incident-reporter-token
LoadCredential=canary-hmac-key:/var/lib/secure-ai/credentials/canary-hmac.key
LoadCredential=incident-reporter-token:/var/lib/secure-ai/credentials/incident-reporter-canary.token
UMask=0077

# Root reads root-only canaries and may ask systemd to start the separately
# sandboxed panic fallback. It does not mount, kill, or access block devices.
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=no
NoNewPrivileges=yes
ProtectSystem=strict
ReadOnlyPaths=/etc/secure-ai
ReadOnlyPaths=/var/lib/secure-ai/vault /var/lib/secure-ai/registry /var/lib/secure-ai/keys
ReadWritePaths=/var/lib/secure-ai/state /var/lib/secure-ai/logs /run/secure-ai

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost

CapabilityBoundingSet=
AmbientCapabilities=

LimitCORE=0
SystemCallFilter=@system-service @network-io
SystemCallFilter=~@privileged @resources @mount @clock @debug @swap @reboot @raw-io @module @cpu-emulation @obsolete
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
MemoryMax=96M
TasksMax=24
