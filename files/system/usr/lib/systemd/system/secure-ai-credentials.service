[Unit]
Description=Secure AI root credential provisioning
DefaultDependencies=no
After=local-fs.target
Before=secure-ai-firstboot.service secure-ai-boot-verify.service
Before=secure-ai-policy-engine.service secure-ai-registry.service
Before=secure-ai-tool-firewall.service secure-ai-mcp-firewall.service
Before=secure-ai-runtime-attestor.service secure-ai-integrity-monitor.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/secure-ai/provision-service-credentials.sh
RemainAfterExit=yes
UMask=0077

User=root
Group=root
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX
SystemCallFilter=@system-service @sync
SystemCallFilter=~@mount @clock @debug @swap @reboot @raw-io @module @cpu-emulation @obsolete
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
ReadWritePaths=/var/lib/secure-ai/credentials

[Install]
WantedBy=multi-user.target
