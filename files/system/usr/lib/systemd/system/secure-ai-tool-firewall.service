[Unit]
Description=Secure AI Tool Firewall (policy-gated tool invocation gateway)
ConditionPathExists=/var/lib/secure-ai/vault/.initialized
After=secure-ai-vault-mounted.service secure-ai-registry.service secure-ai-credentials.service
Requires=secure-ai-vault-mounted.service secure-ai-registry.service secure-ai-credentials.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/libexec/secure-ai/landlock-apply.py --require tool_firewall -- /usr/libexec/secure-ai/tool-firewall
Environment=BIND_ADDR=127.0.0.1:8475
Environment=POLICY_PATH=/etc/secure-ai/policy/policy.yaml
Environment=AUDIT_LOG_PATH=/var/lib/secure-ai/logs/tool-firewall-audit.jsonl
Environment=SERVICE_TOKEN_PATH=%d/service-token
LoadCredential=service-token:/var/lib/secure-ai/credentials/tool-firewall.token

# Filesystem isolation
DynamicUser=yes
SupplementaryGroups=secure-ai-logs secure-ai-vault-read
ReadOnlyPaths=/etc/secure-ai
ReadOnlyPaths=/run/secure-ai
ReadOnlyPaths=/var/lib/secure-ai/vault
ReadWritePaths=/var/lib/secure-ai/logs
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid

# Kernel protection
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# Privilege restriction
NoNewPrivileges=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictRealtime=yes

# Capability bounding
CapabilityBoundingSet=
AmbientCapabilities=

# Namespace restrictions
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET

# Tool firewall accepts traffic from local control-plane peers only.
IPAddressDeny=any
IPAddressAllow=localhost

# Syscall filtering
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @clock @debug @swap @reboot @raw-io @module @cpu-emulation @obsolete
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM

# Resource limits
MemoryMax=256M
CPUQuota=25%
TasksMax=32
LimitNOFILE=512
LimitCORE=0

# Production timeouts and restart limits
TimeoutStartSec=30
TimeoutStopSec=15
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
