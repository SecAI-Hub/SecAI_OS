[Unit]
Description=Secure AI Agent (policy-bound local autopilot)
ConditionPathExists=/var/lib/secure-ai/vault/.initialized
After=secure-ai-registry.service secure-ai-tool-firewall.service secure-ai-inference.service secure-ai-credentials.service secure-ai-vault-mounted.service
Requires=secure-ai-registry.service secure-ai-tool-firewall.service secure-ai-credentials.service secure-ai-vault-mounted.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/libexec/secure-ai/agent
Environment=BIND_ADDR=unix:/run/secure-ai/agent/agent.sock
Environment=INFERENCE_URL=http://127.0.0.1:8465
Environment=REGISTRY_URL=http://127.0.0.1:8470
Environment=TOOL_FIREWALL_URL=http://127.0.0.1:8475
Environment=AIRLOCK_URL=http://127.0.0.1:8490
Environment=SEARCH_MEDIATOR_URL=http://127.0.0.1:8485
Environment=AGENT_POLICY_PATH=/etc/secure-ai/policy/agent.yaml
Environment=VAULT_ROOT=/var/lib/secure-ai/vault
Environment=AUDIT_LOG_PATH=/var/lib/secure-ai/logs/agent-audit.jsonl
Environment=AUDIT_HMAC_KEY_PATH=%d/audit-hmac-key
Environment=AGENT_TASK_STATE_PATH=/var/lib/secure-ai/agent/tasks.json
Environment=AGENT_CONTAINMENT_STATE_PATH=/var/lib/secure-ai/agent/containment.json
Environment=AGENT_UI_TOKEN_PATH=%d/ui-control-token
Environment=AGENT_CONTAINMENT_TOKEN_PATH=%d/containment-token
Environment=AGENT_SIGNING_KEY_PATH=%d/signing-key
Environment=AIRLOCK_TOKEN_PATH=%d/airlock-token
Environment=REGISTRY_TOKEN_PATH=%d/registry-token
Environment=TOOL_FIREWALL_TOKEN_PATH=%d/tool-firewall-token
LoadCredential=airlock-token:/var/lib/secure-ai/credentials/airlock.token
LoadCredential=registry-token:/var/lib/secure-ai/credentials/registry-read.token
LoadCredential=tool-firewall-token:/var/lib/secure-ai/credentials/tool-firewall.token
LoadCredential=audit-hmac-key:/var/lib/secure-ai/credentials/agent-audit-hmac.key
LoadCredential=ui-control-token:/var/lib/secure-ai/credentials/agent-ui.token
LoadCredential=containment-token:/var/lib/secure-ai/credentials/agent-containment.token
LoadCredential=signing-key:/var/lib/secure-ai/credentials/agent-signing.key

# Filesystem isolation
DynamicUser=yes
SupplementaryGroups=secure-ai-services secure-ai-agent-ipc secure-ai-agent-state secure-ai-logs secure-ai-vault-read secure-ai-vault-write
ReadOnlyPaths=/etc/secure-ai
ReadWritePaths=/run/secure-ai/agent
ReadOnlyPaths=/var/lib/secure-ai/vault/user_docs
ReadWritePaths=/var/lib/secure-ai/vault/outputs
ReadWritePaths=/var/lib/secure-ai/logs
ReadWritePaths=/var/lib/secure-ai/agent
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid

# Kernel protection
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# Privilege restriction — loopback-only IPC to other services
NoNewPrivileges=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictRealtime=yes

# Capability bounding
CapabilityBoundingSet=
AmbientCapabilities=

# Network restriction — enforce loopback-only at IP level.
# The agent needs AF_INET for HTTP to peer services on localhost,
# but must never connect to external addresses.
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET

# Syscall filtering — @system-service covers core operations;
# @network-io is required for loopback HTTP (socket, connect, sendto,
# recvfrom, bind, listen, accept). Additional deny groups block
# everything else.
SystemCallFilter=@system-service @network-io
SystemCallFilter=~@privileged @resources @mount @clock @debug @swap @reboot @raw-io @module @cpu-emulation @obsolete
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM

# Device cgroup — high-risk mode: agent must never access devices (M43/M5)
DevicePolicy=closed
DeviceAllow=

# Resource limits — high-risk mode fork/fd caps (M43)
MemoryMax=512M
CPUQuota=50%
TasksMax=64
LimitNPROC=64
LimitNOFILE=1024
LimitCORE=0

# Production timeouts and restart limits
TimeoutStartSec=30
TimeoutStopSec=15
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
