[Unit]
Description=Secure AI Appliance - Search Mediator (Sanitized Web Search)
After=secure-ai-searxng.service secure-ai-credentials.service
Requires=secure-ai-credentials.service
Wants=secure-ai-searxng.service

[Service]
Type=simple
ExecStart=/usr/libexec/secure-ai/landlock-apply.py --require search_mediator -- /usr/libexec/secure-ai/search-mediator
Restart=on-failure
RestartSec=5

Environment=BIND_ADDR=127.0.0.1:8485
Environment=SEARXNG_URL=http://127.0.0.1:8888
Environment=APPLIANCE_CONFIG=/etc/secure-ai/config/appliance.yaml
Environment=POLICY_PATH=/etc/secure-ai/policy/policy.yaml
Environment=AUDIT_DIR=/var/lib/secure-ai/logs
# AuditChain serialization is process-local; never fork multiple writers.
Environment=GUNICORN_WORKERS=1
Environment=AUDIT_HMAC_KEY_PATH=%d/audit-hmac-key
Environment=SERVICE_TOKEN_PATH=%d/service-token
LoadCredential=service-token:/var/lib/secure-ai/credentials/search-mediator.token
LoadCredential=audit-hmac-key:/var/lib/secure-ai/credentials/search-audit-hmac.key

# Filesystem isolation — only talks to SearXNG on localhost
DynamicUser=yes
SupplementaryGroups=secure-ai-logs
ReadWritePaths=/var/lib/secure-ai/logs
ReadOnlyPaths=/etc/secure-ai
ReadOnlyPaths=/run/secure-ai
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid

# Kernel protection
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# Privilege restriction
NoNewPrivileges=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictRealtime=yes

# Capability bounding
CapabilityBoundingSet=
AmbientCapabilities=

# Network restriction — mediator only talks to local SearXNG
IPAddressDeny=any
IPAddressAllow=localhost

# Namespace restrictions
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_UNIX

# Syscall filtering
SystemCallFilter=@system-service @network-io
SystemCallFilter=~@privileged @resources @mount @clock @debug @swap @reboot @raw-io @module @cpu-emulation @obsolete
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM

# Device cgroup — deny all device access (M43/M5)
DevicePolicy=closed
DeviceAllow=

# Resource limits (M43/M5 tightened)
MemoryMax=256M
CPUQuota=25%
TasksMax=64
LimitNPROC=32
LimitNOFILE=512
LimitCORE=0

# Production timeouts
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
