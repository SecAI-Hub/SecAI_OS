[Unit]
Description=Secure AI GPU bootstrap checks (independent of model services)
Requires=secure-ai-credentials.service
After=secure-ai-credentials.service
Before=secure-ai-runtime-attestor.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=exec
ExecCondition=/usr/libexec/secure-ai/gpu-integrity-watch policy-enabled
ExecStart=/usr/libexec/secure-ai/landlock-apply.py --require gpu_bootstrap -- /usr/libexec/secure-ai/gpu-integrity-watch daemon
Environment=INTEGRITY_PROFILE=/etc/secure-ai/gpu-integrity/bootstrap-profile.yaml
Environment=AUDIT_LOG=/var/lib/secure-ai/logs/gpu-bootstrap-audit.jsonl
Environment=SERVICE_TOKEN_PATH=%d/service-token
Environment=INCIDENT_RECORDER_TOKEN_PATH=%d/incident-reporter-token
Environment=GPU_ATTESTATION_SCOPE=bootstrap
Environment=GPU_ATTESTATION_KEY_PATH=%d/gpu-bootstrap-attestation-key
LoadCredential=service-token:/var/lib/secure-ai/credentials/gpu-bootstrap.token
LoadCredential=gpu-bootstrap-attestation-key:/var/lib/secure-ai/credentials/gpu-bootstrap-attestation-hmac.key
LoadCredential=incident-reporter-token:/var/lib/secure-ai/credentials/incident-reporter-gpu-integrity.token
DynamicUser=yes
SupplementaryGroups=secure-ai-logs video render
UMask=0077
ReadOnlyPaths=/etc/secure-ai
ReadWritePaths=/var/lib/secure-ai/logs
InaccessiblePaths=/var/lib/secure-ai/vault /var/lib/secure-ai/gpu-integrity
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictRealtime=yes
CapabilityBoundingSet=
AmbientCapabilities=
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET
SystemCallFilter=@system-service landlock_create_ruleset landlock_add_rule landlock_restrict_self
SystemCallFilter=~@privileged @mount @clock @debug @swap @reboot @module @cpu-emulation @obsolete
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
DevicePolicy=closed
DeviceAllow=/dev/nvidia* rw
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/dri/* rw
DeviceAllow=/dev/kfd rw
MemoryMax=128M
CPUQuota=10%
TasksMax=32
LimitNOFILE=512
LimitCORE=0
TimeoutStartSec=30
TimeoutStopSec=15
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
