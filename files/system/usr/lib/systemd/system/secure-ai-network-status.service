[Unit]
Description=Observe native firewall rules and expiring network scope
Requires=secure-ai-network-boot.service
After=secure-ai-network-boot.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/secure-ai/network-profile.py observe
TimeoutStartSec=25
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
InaccessiblePaths=-/var/lib/secure-ai/vault -/var/lib/secure-ai/credentials -/var/lib/secure-ai/keys
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
IPAddressDeny=any
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=
RestrictNamespaces=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
LimitCORE=0
MemoryMax=96M
TasksMax=16
ReadOnlyPaths=/etc/nftables
ReadWritePaths=/run/secure-ai /run/secure-ai-network
