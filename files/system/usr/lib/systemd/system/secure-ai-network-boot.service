[Unit]
Description=Install verified native offline networking before network managers
DefaultDependencies=no
Requires=systemd-tmpfiles-setup.service
After=local-fs.target systemd-sysusers.service systemd-tmpfiles-setup.service
Before=network-pre.target NetworkManager.service systemd-networkd.service secure-ai-firstboot.service
Before=sysinit.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
RuntimeDirectory=secure-ai-network
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/usr/libexec/secure-ai/network-profile.py boot
ExecStop=/usr/libexec/secure-ai/network-profile.py close
TimeoutStartSec=30
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
InaccessiblePaths=-/var/lib/secure-ai/vault -/var/lib/secure-ai/credentials -/var/lib/secure-ai/keys
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
IPAddressDeny=any
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=
RestrictNamespaces=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
LimitCORE=0
MemoryMax=96M
TasksMax=16
ReadOnlyPaths=/etc/nftables
ReadWritePaths=/run/secure-ai /run/secure-ai-network

[Install]
WantedBy=sysinit.target
