[Unit]
Description=Secure AI DNS Leak Detection Check
After=secure-ai-network-boot.service

[Service]
Type=oneshot
ExecCondition=/usr/libexec/secure-ai/network-profile.py require-maintenance
ExecStart=/usr/libexec/secure-ai/check-dns-leak.sh

# Sandboxing
DynamicUser=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

# Kernel protection
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# Capability bounding — non-root
CapabilityBoundingSet=

LimitCORE=0

# Explicit maintenance diagnostic only; no scheduled Tor probe.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Results go to the local service journal; no persistent success marker.
ReadOnlyPaths=/etc/secure-ai

# Syscall filtering
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @mount @clock @debug @swap @reboot @module @cpu-emulation @obsolete
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM

# Resource limits
MemoryMax=64M
TasksMax=16
