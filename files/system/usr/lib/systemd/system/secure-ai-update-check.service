[Unit]
Description=Secure AI Update Check (cosign-verified)
After=secure-ai-network-boot.service
Requires=secure-ai-native-admission.service
After=secure-ai-native-admission.service

[Service]
Type=oneshot
ExecCondition=/usr/libexec/secure-ai/network-profile.py require-maintenance
ExecStart=/usr/libexec/secure-ai/secure-native-admission.py supervise-update-check
KillMode=control-group
Delegate=no
TimeoutStartSec=240
TimeoutStopSec=15

User=root
Group=root
UMask=0077
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes

# Kernel protection
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# Capability bounding — non-root
CapabilityBoundingSet=

# Syscall filtering
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @mount @clock @debug @swap @reboot @module @cpu-emulation @obsolete
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM

LimitCORE=0

ReadWritePaths=/var/lib/secure-ai/logs /run/secure-ai
ReadOnlyPaths=/var/lib/secure-ai-native-admission /run/secure-ai-native-admission
ReadOnlyPaths=/var/lib/secure-ai/updates /etc/pki/containers
