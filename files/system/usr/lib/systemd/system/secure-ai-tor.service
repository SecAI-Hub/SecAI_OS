[Unit]
Description=Secure AI Appliance - Tor Anonymous Proxy
After=secure-ai-network-boot.service secure-ai-tor-check.service
Requires=secure-ai-network-boot.service secure-ai-tor-check.service

[Service]
Type=simple
ExecStart=/usr/bin/tor -f /etc/secure-ai/tor/torrc
Restart=on-failure
RestartSec=10

# Sandboxing — Tor needs network but nothing else
User=secure-ai-tor
Group=secure-ai-tor
SupplementaryGroups=secure-ai-tor secure-ai-logs
UMask=0077
RemoveIPC=yes
SELinuxContext=system_u:system_r:tor_t:s0
ProtectSystem=strict
ReadWritePaths=/var/lib/secure-ai/tor /var/lib/secure-ai/logs
ReadOnlyPaths=/etc/secure-ai/tor
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
RestrictSUIDSGID=yes

# Kernel protection
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes

# Tor needs network (it IS the network proxy)
# But restrict to IPv4/IPv6 TCP only
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Clipboard isolation (M21) — no access to user clipboard
PrivateUsers=yes

# No GPU, no devices
PrivateDevices=yes

# Syscall filtering
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @mount @clock @debug @swap @reboot @module @cpu-emulation @obsolete
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM

# Resource limits
MemoryMax=256M
TasksMax=64
LimitCORE=0
LimitFSIZE=64M

# Production timeouts
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
