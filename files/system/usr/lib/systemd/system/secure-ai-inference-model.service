[Unit]
Description=Apply one verified inference model selection
After=local-fs.target secure-ai-credentials.service secure-ai-registry.service

[Service]
Type=oneshot
User=root
SupplementaryGroups=secure-ai-ui-control secure-ai-services secure-ai-registry
ExecStart=/usr/bin/python3 /usr/libexec/secure-ai/apply-inference-model.py
TimeoutStartSec=360
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadOnlyPaths=/var/lib/secure-ai/registry /var/lib/secure-ai/vault/models
ReadWritePaths=/run/secure-ai-ui /run/secure-ai/inference-control /var/lib/secure-ai/inference
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @clock @debug @swap @reboot @raw-io @module @cpu-emulation @obsolete
SystemCallArchitectures=native
SystemCallErrorNumber=EPERM
LimitCORE=0
MemoryMax=128M
TasksMax=32
