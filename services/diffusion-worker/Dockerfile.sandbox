ARG COMPUTE=cpu
ARG TARGETARCH

FROM cgr.dev/chainguard/python:latest-dev@sha256:3be081f6cae8f1678609f6ae00b1dfebd6819c3ce75b7c574663af84afe99cc4 AS build

ARG COMPUTE
ARG TARGETARCH

# hadolint ignore=DL3002
USER root
WORKDIR /app

RUN test "$TARGETARCH" = "amd64" || \
    { echo "diffusion locks support only linux/amd64 (got: ${TARGETARCH:-unknown})" >&2; exit 64; }

ENV PYTHON_VERSION=3.14.5 \
    PYTHON_TARBALL_SHA256=7e32597b99e5d9a39abed35de4693fa169df3e5850d4c334337ffd6a19a36db6 \
    PREFIX=/opt/python \
    PATCH_DIR=/build/cpython-patches \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:/usr/bin:/bin \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

COPY build/custom-python/install-cpython-wolfi.sh /build/install-cpython.sh
COPY build/cpython-patches/ /build/cpython-patches/
RUN chmod 0555 /build/install-cpython.sh && /build/install-cpython.sh
ENV PATH=/opt/venv/bin:/opt/python/bin:/usr/bin:/bin
RUN /opt/python/bin/python3 -m venv "$VIRTUAL_ENV"

COPY files/scripts/diffusion-cpu-py314.lock \
     files/scripts/diffusion-cuda-py314.lock \
     files/scripts/diffusion-rocm-py314.lock \
     /tmp/diffusion-locks/

RUN case "$COMPUTE" in \
        cpu|cuda|rocm) lock="/tmp/diffusion-locks/diffusion-${COMPUTE}-py314.lock" ;; \
        *) echo "unsupported COMPUTE backend: $COMPUTE" >&2; exit 64 ;; \
    esac && \
    pip install --no-cache-dir --require-hashes -r "$lock" && \
    rm -rf /tmp/diffusion-locks

# The runtime image does not need packaging tooling. Removing it trims unused
# attack surface, including vendored helper packages bundled inside setuptools.
RUN rm -rf \
    /opt/python/bin/pip* \
    /opt/python/lib/python3.14/ensurepip \
    /opt/python/lib/python3.14/site-packages/pip \
    /opt/python/lib/python3.14/site-packages/pip-*.dist-info \
    /opt/python/lib/python3.14/site-packages/pkg_resources \
    /opt/python/lib/python3.14/site-packages/setuptools \
    /opt/python/lib/python3.14/site-packages/setuptools-*.dist-info \
    /opt/python/lib/python3.14/site-packages/wheel \
    /opt/python/lib/python3.14/site-packages/wheel-*.dist-info \
    /opt/venv/bin/pip* \
    /opt/venv/lib/python3.14/site-packages/pip \
    /opt/venv/lib/python3.14/site-packages/pip-*.dist-info \
    /opt/venv/lib/python3.14/site-packages/pkg_resources \
    /opt/venv/lib/python3.14/site-packages/setuptools \
    /opt/venv/lib/python3.14/site-packages/setuptools-*.dist-info \
    /opt/venv/lib/python3.14/site-packages/wheel \
    /opt/venv/lib/python3.14/site-packages/wheel-*.dist-info

COPY services/diffusion-worker/app.py /app/app.py
COPY services/diffusion-worker/entrypoint.py /app/entrypoint.py

RUN chmod 0555 /app/entrypoint.py && \
    chown -R 65534:65534 /app /opt/python /opt/venv

FROM cgr.dev/chainguard/wolfi-base:latest@sha256:003627df3c1e1bba0c4116afcddb314aca9594ee2328c7e876a8081a6c988b2e

USER root
WORKDIR /app

ENV VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:/opt/python/bin:/usr/bin:/bin \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apk upgrade --no-cache && \
    apk add --no-cache \
    ca-certificates \
    expat \
    gdbm \
    libbz2-1 \
    libffi \
    libgcc \
    libstdc++ \
    ncurses \
    openssl \
    readline \
    sqlite \
    xz \
    zlib

COPY --from=build /opt/python /opt/python
COPY --from=build /opt/venv /opt/venv
COPY --from=build /app /app

USER 65534:65534
EXPOSE 8455
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=5 CMD ["/opt/venv/bin/python", "-c", "from urllib.request import urlopen; import os, sys; port=os.getenv('BIND_ADDR','127.0.0.1:8455').rsplit(':',1)[-1]; sys.exit(0 if urlopen(f'http://127.0.0.1:{port}/health', timeout=5).status == 200 else 1)"]
ENTRYPOINT ["/opt/venv/bin/python", "/app/entrypoint.py"]
