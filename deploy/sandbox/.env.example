# Sandbox stack defaults.
# Copy this file to deploy/sandbox/.env to override values locally.

# UI is the only service published to the host by default.
SECAI_UI_PORT=8480

# Auto prefers rootful Podman Server 5.3+ on native Linux, then Docker
# Server 28+. Rootless engines are not supported by the host-control route.
# The selected engine is pinned until scripts/sandbox/stop.* succeeds.
SECAI_CONTAINER_RUNTIME=auto

# Optional profiles:
#   scripts/sandbox/start.* --with-inference
#   scripts/sandbox/start.* --with-diffusion
# Select one of the locally declared Dockerfile targets (never an upstream tag):
# inference-cpu, inference-cuda, inference-cuda13, inference-rocm,
# inference-vulkan, inference-intel, inference-openvino
SECAI_INFERENCE_TARGET=inference-cpu
SECAI_INFERENCE_MODEL_PATH=
SECAI_CONTEXT_SIZE=8192
SECAI_GPU_LAYERS=0

SECAI_DIFFUSION_COMPUTE=cpu
SECAI_DIFFUSION_DEVICE_PREFERENCE=auto
SECAI_DIFFUSION_CPU_OFFLOAD=0
